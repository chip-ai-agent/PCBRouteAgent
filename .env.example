# Copy to ~/.config/routeagent/env (chmod 600) or to ./.env (gitignored).
# Values from this file win over the shell environment. Lines with placeholders are ignored.

ANTHROPIC_API_KEY=REPLACE-ME
# ROUTEAGENT_ANTHROPIC_MODEL=claude-opus-5-5
# ROUTEAGENT_ANTHROPIC_EFFORT=medium          # low | medium | high; not sent when unset
# ROUTEAGENT_MAX_TOKENS=32000

# OPENAI_API_KEY=REPLACE-ME
# ROUTEAGENT_OPENAI_MODEL=gpt-4o

# PCBWORLD_ROOT=/path/to/PCBWorld             # default: third_party/PCBWorld
# PCBWORLD_DATA_ROOT=/path/to/datasets        # default: $PCBWORLD_ROOT/var/datasets
