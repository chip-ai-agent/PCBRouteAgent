+_ANTHROPIC_NO_TEMPERATURE = re.compile(r"claude-(opus|sonnet|haiku|fable|mythos)-5")
+
+
+def _call_anthropic(system_prompt, user_prompt, model, temperature, max_tokens, api_key=None,
+                    prompt_cache=False, effort=None, **_kw):
+    """One Anthropic Messages call.
+
+    Claude 5.x models reject ``temperature`` (400) and answer with a ``thinking`` block before
+    the text, so the sampling knob is dropped for them and only ``text`` blocks are joined.
+    ``prompt_cache`` tags the (board-constant) system prompt with ``cache_control``;
+    ``effort`` maps ``--api_reasoning_effort`` onto ``output_config.effort``.
+    """
     from anthropic import Anthropic
     client = Anthropic(**({"api_key": api_key} if api_key else {}))
-    resp = client.messages.create(
-        model=model,
-        system=system_prompt,
-        messages=[{"role": "user", "content": user_prompt}],
-        temperature=temperature,
-        max_tokens=max_tokens,
-    )
-    text = resp.content[0].text
+    system = ([{"type": "text", "text": system_prompt, "cache_control": {"type": "ephemeral"}}]
+              if prompt_cache else system_prompt)
+    kw = dict(model=model, system=system, messages=[{"role": "user", "content": user_prompt}], max_tokens=max_tokens)
+    if temperature is not None and not _ANTHROPIC_NO_TEMPERATURE.search(model):
+        kw["temperature"] = temperature
+    if effort:
+        kw["output_config"] = {"effort": {"minimal": "low"}.get(effort, effort)}
+    resp = client.messages.create(**kw)
+    text = "".join(getattr(b, "text", "") for b in resp.content if getattr(b, "type", "") == "text")
     return text, (resp.usage.input_tokens, resp.usage.output_tokens)
 
 
